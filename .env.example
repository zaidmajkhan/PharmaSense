# Copy to .env for local development. The key is only read by the server
# (src/app/api/ask+api.ts) and is never bundled into the app.
# For deployed builds, set it with: eas env:create --name ANTHROPIC_API_KEY --environment production --visibility secret
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
